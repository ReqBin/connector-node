{
  "name": "@reqbin/connector",
  "version": "0.1.0",
  "description": "ReqBin Connector (local agent): bridge browser HTTP(S) requests to resources in local network.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "reqbin-agent": "./dist/bin/reqbin-agent.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "reqbin",
    "connector",
    "agent",
    "proxy",
    "local",
    "bridge",
    "relay",
    "tunnel"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prestart": "npm run build",
    "start": "node dist/bin/reqbin-agent.js",
    "test": "node -e \"console.log('ok')\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ReqBin/connector-node.git"
  },
  "author": "ReqBin <dev@reqbin.com> (https://github.com/ReqBin)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ReqBin/connector-node/issues"
  },
  "homepage": "https://github.com/ReqBin/connector-node#readme",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/swagger": "^9.7.0",
    "@webquarx/design-patterns": "^1.1.6",
    "fastify": "^5.8.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@vitest/coverage-v8": "^3.1.3",
    "eslint": "^9.39.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^3.1.3"
  }
}
